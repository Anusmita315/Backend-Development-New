<!DOCTYPE html>
<html>
    <head>
        <title>Student List</title>
        <link rel="stylesheet" href="/css/style.css">
      </head>
<body>

  <h1>Student List</h1>

  <p>Total students: <%= students.length %></p>

  <table border="1">
    <tr>
      <th>Name</th>
      <th>Course</th>
    </tr>

    <% students.forEach(student => { %>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.course %></td>
      </tr>
    <% }) %>
  </table>

</body>
</html>